 }
+
+/// The (already trimmed) override values that may reach `generate_cargo_keys()`:
+/// - upstream, unchanged: 0..=64 ASCII hex digits (empty stays inert);
+/// - Kraskus: 1..=64 ASCII hex digits, the literal `-kraskus-devfee`, then one
+///   or more ASCII digits, and nothing else.
+///
+/// Both shapes are ASCII alphanumerics plus fixed hyphens, so no newline,
+/// space, quote or other character can reach a `cargo:` directive.
+fn is_permitted_commit_hash_override(hash: &str) -> bool {
+	// Longest accepted hex part: a full SHA-256 Git object name.
+	const MAX_LEN: usize = 64;
+	const KRASKUS_DEV_FEE_SUFFIX: &str = "-kraskus-devfee";
+
+	let is_hex = |s: &str| s.len() <= MAX_LEN && s.bytes().all(|b| b.is_ascii_hexdigit());
+	if is_hex(hash) {
+		return true;
+	}
+	match hash.split_once(KRASKUS_DEV_FEE_SUFFIX) {
+		Some((hex, digits)) =>
+			!hex.is_empty() &&
+				is_hex(hex) && !digits.is_empty() &&
+				digits.bytes().all(|b| b.is_ascii_digit()),
+		None => false,
+	}
+}
