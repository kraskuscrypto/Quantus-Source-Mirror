 fn sanitize_git_commit_hash_override() {
 	const VAR: &str = "SUBSTRATE_CLI_GIT_COMMIT_HASH";
-	// Longest accepted value: a full SHA-256 Git object name.
-	const MAX_LEN: usize = 64;
 
